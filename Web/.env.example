# Web 连接后端配置（示例）
# 开发代理目标（影响 /api 请求）
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# 生产环境 API 基地址（部署到静态站点时使用）
# 例如: https://api.example.com
VITE_API_BASE=

# 部署子路径（GitHub Pages 常用: /仓库名/）
VITE_PUBLIC_BASE=/

# 前端 WebSocket 基地址（用于 /ws/web）
# 可写 ws:// 或 wss://，也可写 http:// / https://（会自动转换）
VITE_WS_BASE=ws://127.0.0.1:8000
